# BioCopilot Environment Configuration
PORT=8000
HOST=127.0.0.1
ENVIRONMENT=production-demo

# SQLite Database
DATABASE_URL=sqlite:///./backend/app/database_store/biocopilot.db

# Optional External LLM Integration (OFF by default for local competition mode)
ENABLE_EXTERNAL_LLM=false
EXTERNAL_LLM_PROVIDER=none
EXTERNAL_LLM_API_KEY=
